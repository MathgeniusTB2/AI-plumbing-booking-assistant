# Free local inference (no API billing): https://ollama.com/
# Recommended:   ollama pull qwen2.5:3b-instruct
# Then keep the daemon running (default port 11434).

# 1 = try local LLM when server is reachable; 0 = rules-only heuristic extractor
USE_LLM=1

# OpenAI-compatible API base URL
# Ollama: http://127.0.0.1:11434/v1
# LM Studio: often http://127.0.0.1:1234/v1 )
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Default matches `ollama pull qwen2.5:3b-instruct` (good JSON + slot filling on CPU)
LOCAL_LLM_MODEL=qwen2.5:3b-instruct

# Sampling temperature for extraction (keep low for stable JSON)
LOCAL_LLM_TEMPERATURE=0.2

# Dummy key — required by HTTP client; Ollama ignores it
LOCAL_LLM_API_KEY=ollama
